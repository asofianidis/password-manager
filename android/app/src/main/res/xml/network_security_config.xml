<?xml version="1.0" encoding="utf-8"?>
<!--
  Sync talks plain HTTP to computers on your tailnet or LAN (100.x.y.z, 192.168.x.y, *.ts.net),
  which a domain list can't express. Every sync payload is AES-256-GCM sealed with the vault key,
  and Tailscale adds WireGuard; see docs/SYNC_PROTOCOL.md. The only other requests are update
  checks and downloads from GitHub, which must use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
    </domain-config>
</network-security-config>
