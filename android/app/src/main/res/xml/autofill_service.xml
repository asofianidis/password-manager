<?xml version="1.0" encoding="utf-8"?>
<!--
  Chrome (135+) and Firefox talk to autofill services directly. Browsers listed here are filled in
  compatibility mode, which reads the page through the accessibility tree.
-->
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.asofianidis.passwordmanager.MainActivity"
    android:supportsInlineSuggestions="true">
    <compatibility-package android:name="com.sec.android.app.sbrowser" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.sec.android.app.sbrowser.beta" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.opera.browser" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.opera.browser.beta" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.opera.mini.native" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.opera.gx" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.vivaldi.browser" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.duckduckgo.mobile.android" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.kiwibrowser.browser" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.yandex.browser" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.ecosia.android" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.mi.globalbrowser" android:maxLongVersionCode="10000000000" />
    <compatibility-package android:name="com.naver.whale" android:maxLongVersionCode="10000000000" />
</autofill-service>
