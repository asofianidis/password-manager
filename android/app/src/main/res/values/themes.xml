<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Password Manager</string>

    <color name="canvas">#0A0B0A</color>

    <style name="Theme.PasswordManager" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Autofill's unlock, pick, and save screens: a card over the app being filled -->
    <style name="Theme.PasswordManager.Sheet">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
</resources>
