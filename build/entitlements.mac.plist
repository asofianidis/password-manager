<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!--
    Hardened runtime exceptions for the app and its helpers. Each one weakens a protection, so
    keep this list to what Electron needs to run.
  -->
  <dict>
    <!-- V8 compiles JavaScript and WebAssembly (Argon2 in hash-wasm) at runtime into MAP_JIT memory -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
